# Copy this file to .env. Git ignores .env, and only scripts on your machine read it:
# npm run admin, npm run setup and npm run daily.

# Your local JSONyan client. On jsonyan.com, open the project, choose Clients, then Create client,
# then Copy .env, and paste it over these six lines.
JSONYAN_URL=https://api.jsonyan.com
JSONYAN_API_PATH=/aws-blocks/api
JSONYAN_TOKEN_URL=https://api.jsonyan.com/oauth2/token
JSONYAN_PROJECT_ID=
JSONYAN_CLIENT_ID=
JSONYAN_CLIENT_SECRET=

# Your OpenAI API key. The admin's server uses it when you submit a word; it never reaches the
# browser. The daily job does not use it: it uses the copy saved in JSONyan as the secret
# openAIApiKey.
OPENAI_API_KEY=
