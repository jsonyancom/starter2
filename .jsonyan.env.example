# Your JSONyan client. Create .jsonyan.env beside this file with the client's Copy .env:
# on jsonyan.com, open the project, choose Clients, then Create client, then Copy .env.
#
# Git ignores .jsonyan.env. npm run admin, npm run setup and npm run daily read it, and
# npm run github:env sends these six values to your GitHub repository for the daily job.
JSONYAN_URL=https://api.jsonyan.com
JSONYAN_API_PATH=/aws-blocks/api/v1
JSONYAN_TOKEN_URL=https://api.jsonyan.com/oauth2/token
JSONYAN_PROJECT_ID=
JSONYAN_CLIENT_ID=
JSONYAN_CLIENT_SECRET=
