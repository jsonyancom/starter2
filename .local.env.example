# Keys that stay on your machine. Copy this file to .local.env; Git ignores .local.env, and
# nothing sends it to GitHub.

# Your OpenAI API key. The admin's server uses it when you submit a word; it never reaches the
# browser. The daily job does not use it: it uses the copy saved in JSONyan as the secret
# openAIApiKey.
OPENAI_API_KEY=
